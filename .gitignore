# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Playwright MCP ad-hoc artefacts (captures + snapshots YAML auto-générés)
.playwright-mcp/
/*.png
/*.jpeg
/*.jpg
/*.yml
/structure-snapshot.md
/snap-*.md

# Claude Code : settings perso ignorés, mais skills & commands versionnés
# (style-guide aedral-style, commande /review — partagés avec le projet)
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/workflows/
.mcp.json

.env*.local
tsc-output.txt

# Sorties locales de scripts/render-poster.mjs (affiches PNG à juger)
tmp/

# Gabarits ManiaPub (1 Mo chacun, assets en base64) — regénérés par build_maniapub.py
scripts/affiche-mania-cup/maniapub-*.html

# Scripts d'inspection jetables (lecture Firestore, diagnostic ponctuel).
# Deux fois en une journée ils sont partis dans un commit avec `git add -A` :
# les ignorer coûte moins cher que de s'en souvenir.
tmp-*.mjs

# Bancs et maquettes servis en local depuis public/ (scripts/mesure-badges.mjs,
# scripts/maquette-badge-ecurie.mjs). Jamais déployés : ils seraient publics.
public/mesure-badges.html
public/maquette-badge.html
